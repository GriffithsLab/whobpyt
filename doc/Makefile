# Makefile for the WhoBPyT Sphinx documentation
#
#   make html          build the full site, running every example (slow)
#   make html-noplot   build the site without running the examples (fast)
#   make check         full build with nitpicky warnings, then check links
#   make clean         remove the build and all generated gallery files
#
# To build a single example while working on it:
#   sphinx-build -D sphinx_gallery_conf.filename_pattern=eg__tmseeg.py -b html . _build/html

SPHINXOPTS    ?=
SPHINXBUILD   ?= sphinx-build
SOURCEDIR     = .
BUILDDIR      = _build

help:
	@$(SPHINXBUILD) -M help "$(SOURCEDIR)" "$(BUILDDIR)" $(SPHINXOPTS) $(O)

.PHONY: help Makefile clean html-noplot check install

# Remove the build and the files generated by sphinx-gallery
clean:
	rm -rf $(BUILDDIR)/*
	rm -rf auto_examples
	rm -rf generated
	rm -f sg_api_usage.rst sg_execution_times.rst

html-noplot:
	$(SPHINXBUILD) -D plot_gallery=0 -b html "$(SOURCEDIR)" "$(BUILDDIR)/html" $(SPHINXOPTS) $(O)

check:
	$(MAKE) SPHINXOPTS="-n" html
	$(MAKE) linkcheck

# Build the site and push it to the gh-pages branch by hand.
# (Normally the Docs GitHub Action does this on every push to main.)
install:
	$(MAKE) clean
	git clone -b gh-pages --single-branch --no-checkout --depth 1 git@github.com:griffithslab/whobpyt $(BUILDDIR)/gh_pages
	touch $(BUILDDIR)/gh_pages/.nojekyll
	$(MAKE) html
	cd $(BUILDDIR)/ && \
	cp -r html/* gh_pages && \
	cd gh_pages && \
	git add * && \
	git add .nojekyll && \
	git commit -a -m 'Make install' && \
	git push

# Catch-all target: route all unknown targets to Sphinx using the new
# "make mode" option.  $(O) is meant as a shortcut for $(SPHINXOPTS).
%: Makefile
	@$(SPHINXBUILD) -M $@ "$(SOURCEDIR)" "$(BUILDDIR)" $(SPHINXOPTS) $(O)
