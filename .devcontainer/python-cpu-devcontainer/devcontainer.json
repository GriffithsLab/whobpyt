{
    "name": "WhoBPyT-CPU",
    "image": "mcr.microsoft.com/devcontainers/python:3.10",
      
    "customizations": {
      "vscode": {
        "extensions": [
          "ms-python.python"
        ],
        "settings": {
          "python.pythonPath": "/usr/local/bin/python"
        }
      }
    },
  
    "forwardPorts": [
      8000
    ],
    "postCreateCommand": "pip install -e \".[examples,test]\" && echo 'Dependencies installed'",
    "appPort": 8000
  
  }